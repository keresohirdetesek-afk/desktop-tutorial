# Átlagsebesség.hu — Apache beállítások megosztott tárhelyre.
#
# Ha a szolgáltatód nem Apache-ot használ (nginx, LiteSpeed saját
# konfigurációval), ez a fájl hatástalan — akkor a szolgáltató
# vezérlőpultjában kell ugyanezt beállítani.

# ---------------------------------------------------------------- HTTPS
# GPS-hez kötelező: titkosítatlan oldalon a böngésző nem ad helyzetet.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # www -> www nélküli alak (az oldal canonical-ja ez)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ------------------------------------------------------------ MIME-típusok
<IfModule mod_mime.c>
  AddType application/manifest+json  .webmanifest
  AddType image/svg+xml              .svg
  AddType font/woff2                 .woff2
</IfModule>

# ----------------------------------------------------------- gyorsítótár
<IfModule mod_headers.c>
  # Ez az oldal fájlnév-verziózás NÉLKÜL frissül: minden kiadásban
  # ugyanaz az `app.css` és `app.js` kerül felül. Ezért a kódnak és a
  # HTML-nek minden kérésnél ellenőriznie kell, különben a kiadás után a
  # látogató a régi felületet látja — akkor is, ha a HTML már az új.
  #
  # A `no-cache` nem tiltja a tárolást, csak feltételes kérést ír elő:
  # ha a fájl nem változott, a kiszolgáló 304-et küld, ami pár bájt.
  #
  # Ebben a listában a `sw.js` is benne van, és ez szándékos. Korábban
  # külön szabály tette kulccsá, de utána egy `\.(css|js|…)$` minta
  # felülírta az órás értékkel — Apache alatt a később illeszkedő
  # `Header set` nyer. Egyetlen minta van, nincs mit felülírni.
  <FilesMatch "\.(html|css|js|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # A képek és a betűtípus tartalma gyakorlatilag állandó. Ha mégis
  # cserélődnek, a service worker telepítéskor `cache: 'reload'`-dal
  # tölti újra őket, ami megkerüli a böngésző gyorsítótárát — ezért itt
  # a hosszabb életidő biztonságos.
  <FilesMatch "\.(svg|png|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# -------------------------------------------------------------- tömörítés
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
  AddOutputFilterByType DEFLATE text/plain application/xml
</IfModule>

# --------------------------------------------------------------- egyebek
# Könyvtárlistázás tiltása.
Options -Indexes
