# Átlagsebesség.hu — Apache beállítások megosztott tárhelyre.
#
# Ha a szolgáltatód nem Apache-ot használ (nginx, LiteSpeed saját
# konfigurációval), ez a fájl hatástalan — akkor a szolgáltató
# vezérlőpultjában kell ugyanezt beállítani.

# ---------------------------------------------------------------- HTTPS
# GPS-hez kötelező: titkosítatlan oldalon a böngésző nem ad helyzetet.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # www -> www nélküli alak (az oldal canonical-ja ez)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ------------------------------------------------------------ MIME-típusok
<IfModule mod_mime.c>
  AddType application/manifest+json  .webmanifest
  AddType image/svg+xml              .svg
  AddType font/woff2                 .woff2
</IfModule>

# ----------------------------------------------------------- gyorsítótár
<IfModule mod_headers.c>
  # A service workert SOHA nem szabad sokáig gyorsítótárazni: ha a böngésző
  # a régi sw.js-t kapja vissza, az app frissítése heteken át elakadhat.
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>

  # A HTML is mindig ellenőrizzen: az app maga kezeli a verziózást.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>

  # A többi állomány neve kiadásonként nem változik, de a service worker
  # hálózat-először tölti őket, ezért itt is rövid életidő a biztos.
  <FilesMatch "\.(css|js|svg|png|woff2)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# -------------------------------------------------------------- tömörítés
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
  AddOutputFilterByType DEFLATE text/plain application/xml
</IfModule>

# --------------------------------------------------------------- egyebek
# Könyvtárlistázás tiltása.
Options -Indexes
